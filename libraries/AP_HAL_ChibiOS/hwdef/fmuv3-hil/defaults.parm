# Default parameters for fmuv3-hil (SITL running on hardware)
# ArduPlane's own aerodynamic model runs on the MCU; X-Plane is used
# for visualisation only (sitl_xplane.py mirrors SIMSTATE to X-Plane).

# EKF3
AHRS_EKF_TYPE 3

# EKF3 yaw source: compass (SITL magnetometer from SIMState)
EK3_SRC1_YAW 1

# Compass: enabled — SITL compass backend reads from SIMState
COMPASS_USE 1

# GPS: SITL internal backend (SIMState provides position/velocity)
GPS1_TYPE 1

# Airspeed: SITL backend (reads differential pressure from SIMState)
ARSPD_TYPE 100

# Safety: no safety switch needed in simulation
BRD_SAFETY_DEFLT 0

# Arming: skip all pre-arm checks for simulation (-1 = skip all)
ARMING_SKIPCHK -1

# Scheduler: 50 Hz — prevents watchdog reset when Plane SITL physics
# runs SIMState::update() on the STM32F427 every loop tick
SCHED_LOOP_RATE 50

# Logging: disabled — SD card not needed for bench simulation
LOG_BITMASK 0
LOG_BACKEND_TYPE 0
LOG_DISARM 0

# SITL speedup: 1x real-time (no speedup on hardware)
SIM_SPEEDUP 1
ARMING_REQUIRE 1
