# XPlane DREF map for conventional plane
# ArduPilot channel assignment (SERVO1_FUNCTION=4/19/70/21):
#   CH1 = aileron  CH2 = elevator  CH3 = throttle  CH4 = rudder
#
# override_joystick=1: X-Plane treats yoke_* as virtual joystick input,
# feeding the full flight model including stability augmentation.
# Ranges are ratios (-1 to +1), so "range" : 1.
# elevator uses angle_neg because X-Plane yoke_pitch_ratio sign is
# opposite to ArduPilot CH2 (positive CH2 = nose up in ArduPilot,
# positive yoke_pitch_ratio = nose down in X-Plane).

{
    "settings" : { "debug" : 0 },

    "sim/operation/override/override_joystick"  : { "type" : "fixed", "value" : 1 },
    "sim/operation/override/override_throttles" : { "type" : "fixed", "value" : 1 },

    # aileron: CH1 → roll ratio
    "sim/joystick/yoke_roll_ratio"    : { "type" : "angle",     "range" : 1, "channel" : 1 },

    # elevator: CH2 → pitch ratio (negated — X-Plane pitch sign is opposite ArduPilot)
    "sim/joystick/yoke_pitch_ratio"   : { "type" : "angle_neg", "range" : 1, "channel" : 2 },

    # rudder: CH4 → heading ratio
    "sim/joystick/yoke_heading_ratio" : { "type" : "angle",     "range" : 1, "channel" : 4 },

    # throttle: CH3 PWM 1000-2000 → 0.0 to 1.0
    "sim/flightmodel/engine/ENGN_thro_use[0]" : { "type" : "range", "range" : 1, "channel" : 3 }
}
